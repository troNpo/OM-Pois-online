// --- FUNCIÓN OVERPASS OPTIMIZADA (Nodos y Radio máx 15km) ---
async function ejecutarConsultaOverpass(lat, lon) {
    const radiusSlider = document.getElementById("search-radius");
    const radiusKm = radiusSlider ? parseInt(radiusSlider.value, 10) : 5;
    const radiusMeters = Math.min(radiusKm * 1000, 15000); // Límite seguro de 15 km[span_1](start_span)[span_1](end_span)

    const checkboxes = document.querySelectorAll(".subcat-checkbox:checked");[span_2](start_span)[span_2](end_span)[span_3](start_span)[span_3](end_span)
    if (checkboxes.length === 0) {
        alert("Por favor, selecciona al menos una categoría o elemento.");
        return;
    }

    let conditions = [];
    checkboxes.forEach(chk => {
        const key = chk.getAttribute("data-key");
        const value = chk.getAttribute("data-value");
        if (key && value) {
            conditions.push(`["${key}"="${value}"]`);
        }
    });

    if (conditions.length === 0) {
        alert("Los elementos seleccionados no tienen etiquetas de mapeo válidas.");
        return;
    }

    let unionParts = conditions.map(cond => `node(around:${radiusMeters}, ${lat}, ${lon})${cond};`);[span_4](start_span)[span_4](end_span)

    const overpassQuery = `
        [out:json][timeout:25];
        (
            ${unionParts.join("\n")}
        );
        out body;
    `;[span_5](start_span)[span_5](end_span)

    try {
        const res = await fetch("https://overpass-api.de/api/interpreter", {
            method: "POST",
            body: overpassQuery
        });

        if (!res.ok) {
            throw new Error(`Error en el servidor de Overpass: ${res.status}`);
        }

        const data = await res.json();
        
        if (!data.elements || data.elements.length === 0) {
            alert("No se han encontrado puntos de interés para los criterios seleccionados en este radio.");
            return;
        }

        currentOverpassElements = data.elements.filter(el => el.type === "node" && el.lat && el.lon);[span_6](start_span)[span_6](end_span)
        
        selectedNodesMap.clear();
        currentOverpassElements.forEach(el => selectedNodesMap.set(el.id, true));[span_7](start_span)[span_7](end_span)

        mostrarPanelResultados();[span_8](start_span)[span_8](end_span)

    } catch (e) {
        console.error("Error en Overpass API:", e);
        alert("Ocurrió un error al conectar con la API de Overpass. Prueba a reducir el radio o desmarcar algunas categorías.");
    }
}

